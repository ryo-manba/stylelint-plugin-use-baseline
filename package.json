{
  "name": "stylelint-plugin-use-baseline",
  "version": "1.4.5",
  "description": "A Stylelint plugin that enforces CSS feature availability based on Baseline.",
  "keywords": [
    "baseline",
    "css",
    "lint",
    "stylelint",
    "stylelint-plugin"
  ],
  "author": "ryo-manba",
  "license": "MIT",
  "funding": "https://github.com/ryo-manba/stylelint-plugin-use-baseline?sponsor=1",
  "homepage": "https://github.com/ryo-manba/stylelint-plugin-use-baseline#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryo-manba/stylelint-plugin-use-baseline"
  },
  "bugs": {
    "url": "https://github.com/ryo-manba/stylelint-plugin-use-baseline/issues"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "watch": "npm test --ignore-scripts -- --watch",
    "build": "rollup -c",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test",
    "build:baseline": "node tools/generate-baseline.js"
  },
  "dependencies": {
    "css-tree": "^3.1.0",
    "is-plain-object": "^5.0.0",
    "postcss": "^8.5.5",
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "stylelint": "^16.0.2 || ^17.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@stylelint/prettier-config": "^3.0.0",
    "common-tags": "^1.8.2",
    "eslint": "^9.29.0",
    "eslint-config-stylelint": "^25.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.0",
    "jest": "^30.0.2",
    "jest-preset-stylelint": "^8.0.0",
    "mdn-data": "^2.31.0",
    "prettier": "^3.5.3",
    "rollup": "^4.43.0",
    "stylelint": "^17.0.0",
    "web-features": "^3.34.3"
  }
}
